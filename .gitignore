# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Generated analysis output (graphify)
graphify-out/

# Stray source-tree archives/backups, not used by any build or deploy step
*.tar.gz
*.tgz

# Replit chat-upload scratch files. Der Ordner ist restlos entfernt, beide
# fruehere Ausnahmen waren toter Code und sind mit dem @assets-Alias
# entfallen. Der Eintrag bleibt, damit Replit-Uploads nicht erneut
# unbemerkt in die Historie wandern.
attached_assets/

# Zugangsdaten und Umgebungsvariablen. Das Admin-Passwort und alle
# Schluessel gehoeren ausschliesslich in die Railway-Variablen bzw. in die
# Datenbank, nie in eine Datei im Repo. Ohne diese Regel wuerde eine lokal
# angelegte .env beim naechsten "git add -A" mitcommittet.
.env
.env.*
!.env.example
*.pem
*.key
!**/pnpm-lock.yaml
